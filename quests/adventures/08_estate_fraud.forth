\ ===========================================================================
\ КВЕСТ: "Фальшивий спадок у маєтку"
\ Почеркознавчий та юридичний детектив
\ ===========================================================================

"Фальшивий спадок у маєтку" TITLE:
"Олександр К." AUTHOR:
"1.0" VERSION:

\ ---------------------------------------------------------------------------
\ Змінні стану
\ ---------------------------------------------------------------------------
0 "will_examined" !
0 "desk_unlocked" !
0 "has_reagent" !
0 "lawyer_confronted" !

GOTO: хол_маєтку

\ ---------------------------------------------------------------------------
\ ЛОКАЦІЯ 1: Хол маєтку
\ ---------------------------------------------------------------------------
SCENE: хол_маєтку
  CLS
  "Вестибюль маєтку Блеквудів" LOCATION:
  "За годину розпочнеться засідання щодо відкриття спадщини." .
  "Розпорядник фонду сидить біля каміна, переглядаючи папери." .
  "Двері ведуть до кабінету покійного, бібліотеки та малої лабораторії." .

  "Пройти до кабінету покійного власника" CHOICE
  "Оглянути приватну бібліотеку" CHOICE
  "Зайти до домашньої фотолабораторії" CHOICE
  "Поговорити з розпорядником" CHOICE
  "Вирушити на судове засідання з доповіддю" CHOICE
  WAIT_CHOICE

  dup 1 = IF drop GOTO: кабінет THEN
  dup 2 = IF drop GOTO: бібліотека THEN
  dup 3 = IF drop GOTO: лабораторія THEN
  dup 4 = IF drop GOTO: розмова_розпорядник THEN
  drop GOTO: фінал_суд
;SCENE

\ ---------------------------------------------------------------------------
\ ЛОКАЦІЯ 2: Кабінет
\ ---------------------------------------------------------------------------
SCENE: кабінет
  CLS
  "Кабінет небіжчика" LOCATION:
  "На дубовому столі лежить копія нового заповіту, завірена два тижні тому." .

  "will_examined" @ NOT IF
    "Оглянути оригінал заповіту через лупу" CHOICE
  THEN

  "desk_unlocked" @ NOT IF
    "Спробувати відчинити замкнену шухляду столу" CHOICE
  ELSE
    "Щоденник покійного вже вилучено з шухляди." .
  THEN

  "Повернутися до холу" CHOICE
  WAIT_CHOICE

  "will_examined" @ NOT IF
    dup 1 = IF
      drop
      1 "will_examined" !
      1 "спірний заповіт" ITEM+
      "Під лупою помітно: текст надруковано на сучасній лазерній машинці, а підпис нанесено пігментним чорнилом." .
      GOTO: кабінет
    THEN
  THEN

  "desk_unlocked" @ NOT IF
    dup 1 = IF
      drop
      "тонкий сталевий пінцет" ITEM? IF
        1 "desk_unlocked" !
        1 "особистий щоденник" ITEM+
        "За допомогою пінцета ви підчіплюєте фіксатор простого замочка. Всередині — щоденник за останній рік!" .
      ELSE
        "Шухляда замкнена на язичковий замочок. Потрібен тонкий інструмент або відмичка." .
      THEN
      GOTO: кабінет
    THEN
  THEN

  drop
  GOTO: хол_маєтку
;SCENE

\ ---------------------------------------------------------------------------
\ ЛОКАЦІЯ 3: Домашня лабораторія
\ ---------------------------------------------------------------------------
SCENE: лабораторія
  CLS
  "Фотолабораторія" LOCATION:
  "Покійний захоплювався класичною плівковою фотографією та хімією." .

  "ультрафіолетовий ліхтарик" ITEM? NOT IF
    "На поличці для сушіння лежить компактний УФ-детектор 365 нм." .
    "Взяти УФ-ліхтарик" CHOICE
  THEN

  "тонкий сталевий пінцет" ITEM? NOT IF
    "У лотку для проявки лежить довгий прецизійний пінцет." .
    "Взяти пінцет" CHOICE
  THEN

  "йодний реактив для паперу" ITEM? NOT IF
    "У склянці з притертим корком стоїть йодний розчин для визначення крохмалю в целюлозі." .
    "Взяти хімічний реактив" CHOICE
  THEN

  "Повернутися до холу" CHOICE
  WAIT_CHOICE

  "ультрафіолетовий ліхтарик" ITEM? NOT IF
    dup 1 = IF drop 1 "ультрафіолетовий ліхтарик" ITEM+ GOTO: лабораторія THEN
  THEN

  "тонкий сталевий пінцет" ITEM? NOT IF
    dup 1 = IF drop 1 "тонкий сталевий пінцет" ITEM+ GOTO: лабораторія THEN
    dup 2 = IF drop 1 "тонкий сталевий пінцет" ITEM+ GOTO: лабораторія THEN
  THEN

  "йодний реактив для паперу" ITEM? NOT IF
    dup 1 = IF drop 1 "йодний реактив для паперу" ITEM+ GOTO: лабораторія THEN
    dup 2 = IF drop 1 "йодний реактив для паперу" ITEM+ GOTO: лабораторія THEN
    dup 3 = IF drop 1 "йодний реактив для паперу" ITEM+ GOTO: лабораторія THEN
  THEN

  drop
  GOTO: хол_маєтку
;SCENE

\ ---------------------------------------------------------------------------
\ ЛОКАЦІЯ 4: Бібліотека
\ ---------------------------------------------------------------------------
SCENE: бібліотека
  CLS
  "Фамільна бібліотека" LOCATION:
  "Стелажі з рідкісними книгами та зразками старого паперу." .

  "спірний заповіт" ITEM? IF
    "ультрафіолетовий ліхтарик" ITEM? IF
      "доказ: змитий текст" ITEM? NOT IF
        "Освітити бланк заповіту ультрафіолетом" CHOICE
      THEN
    THEN
    "йодний реактив для паперу" ITEM? IF
      "доказ: склад паперу" ITEM? NOT IF
        "Нанести мікрокраплю реактиву на кутик аркуша" CHOICE
      THEN
    THEN
  ELSE
    "Щоб дослідити документ, спочатку потрібно взяти оригінал заповіту з кабінету." .
  THEN

  "Повернутися назад" CHOICE
  WAIT_CHOICE

  "спірний заповіт" ITEM? IF
    "ультрафіолетовий ліхтарик" ITEM? IF
      "доказ: змитий текст" ITEM? NOT IF
        dup 1 = IF
          drop
          1 "доказ: змитий текст" ITEM+
          "В УФ-променях чітко проявилися сліди кислотного травлення! На бланку первинно була довіреність на оренду авто, з якої вимили старий текст, залишивши лише справжній підпис унизу!" .
          GOTO: бібліотека
        THEN
      THEN
    THEN
    "йодний реактив для паперу" ITEM? IF
      "доказ: склад паперу" ITEM? NOT IF
        dup 1 = IF
          drop
          1 "доказ: склад паперу" ITEM+
          "Реакція дає синє забарвлення: аркуш містить синтетичний оптичний відбілювач, який почали випускати лише два роки тому. Заповіт ніяк не міг бути складений 10 років тому, як стверджує дата на бланку!" .
          GOTO: бібліотека
        THEN
        dup 2 = IF
          drop
          1 "доказ: склад паперу" ITEM+
          "Крапля реагенту підтверджує сучасне хімічне походження паперу всупереч старій даті складання." .
          GOTO: бібліотека
        THEN
      THEN
    THEN
  THEN

  drop
  GOTO: хол_маєтку
;SCENE

\ ---------------------------------------------------------------------------
\ ЛОКАЦІЯ 5: Розмова з розпорядником
\ ---------------------------------------------------------------------------
SCENE: розмова_розпорядник
  CLS
  "Розмова біля каміна" LOCATION:
  "Розпорядник сухо каже: 'Заповіт складено абсолютно законно. Будь-які претензії родичів суд просто відхилить.'" .

  "особистий щоденник" ITEM? IF
    "Вказати на запис у щоденнику за день складання 'заповіту'" CHOICE
  THEN

  "Назад у хол" CHOICE
  WAIT_CHOICE

  "особистий щоденник" ITEM? IF
    1 = IF
      "Ви зачитуєте: у день датування заповіту покійний перебував на операції в іншій країні і фізично не міг підписати папір у цьому місті." .
      "Розпорядник помітно блідне, але мовчить." .
      1 "доказ: залізне алібі" ITEM+
      "Повернутися" CHOICE
      WAIT_CHOICE
      drop
      GOTO: хол_маєтку
    THEN
  THEN

  drop
  GOTO: хол_маєтку
;SCENE

\ ---------------------------------------------------------------------------
\ ФІНАЛ: Засідання суду
\ ---------------------------------------------------------------------------
SCENE: фінал_суд
  CLS
  "Зала судових засідань" LOCATION:
  "Суддя запитує: 'Чи є у сторони захисту законні заперечення проти визнання заповіту дійсним?'" .

  "Визнати документ через брак очевидних підробок" CHOICE
  "Подати позов про фальсифікацію на підставі доказів" CHOICE
  WAIT_CHOICE

  1 = IF
    "Шахрайський заповіт затверджено. Розпорядник привласнює весь маєток і ліквідує фонд допомоги." DEFEAT
  ELSE
    "доказ: змитий текст" ITEM? IF
      "доказ: склад паперу" ITEM? IF
        "доказ: залізне алібі" ITEM? IF
          "Ви надаєте комплексний експертний висновок: сліди хімічного змивання в ультрафіолеті, анахронічний склад паперу та алібі зі щоденника. Суддя передає справу до поліції, шахрая заарештовано прямо в залі засідання!" VICTORY
        THEN
      THEN
    THEN
    "Суддя відхиляє ваші усні підозри: 'Без неспростовних речових доказів змивання та хімічного аналізу суд не може скасувати документ'. Справу програно." DEFEAT
  THEN
;SCENE