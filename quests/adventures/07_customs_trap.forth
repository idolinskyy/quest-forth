\ ===========================================================================
\ КВЕСТ 2: "Шантаж у портовому терміналі"
\ Аналітичний детектив без фантастики (митні процедури та криміналістика)
\ ===========================================================================

"Шантаж у портовому терміналі" TITLE:
"Олександр К." AUTHOR:
"1.0" VERSION:

\ ---------------------------------------------------------------------------
\ Змінні розслідування
\ ---------------------------------------------------------------------------
0 "docs_checked" !
0 "seal_checked" !
0 "bribe_offered" !
0 "scan_done" !
0 "broker_arrested" !

SCENE: start
  CLS
  "Контрольно-пропускний пункт термінала" LOCATION:
  "23:30. До митного коридору заїхав рефрижераторний напівпричіп з контейнером MSCU-7721." .
  "Експедитор нервує і просить 'швидко підписати акт без зайвого зважування'." .
  "У вас є регламентний набір інспектора та доступ до бази обліку." .
  "Розпочати митний контроль" CHOICE
  WAIT_CHOICE
  drop
  GOTO: office
;SCENE

\ ---------------------------------------------------------------------------
\ Кабінет інспектора (База дій)
\ ---------------------------------------------------------------------------
SCENE: office
  CLS
  "Офіс чергового митного інспектора" LOCATION:
  "На столі лежить папка документів вантажу MSCU-7721, поруч валіза оглядового обладнання." .

  "Ознайомитися з товаросупровідними документами" CHOICE
  "Оглянути контейнер на рампі" CHOICE
  "Опитати митного брокера (експедитора)" CHOICE
  "Перевірити масу вантажу на ваговому комплексі" CHOICE
  "Скласти підсумковий протокол" CHOICE
  WAIT_CHOICE

  dup 1 = IF drop GOTO: check_documents THEN
  dup 2 = IF drop GOTO: inspect_container THEN
  dup 3 = IF drop GOTO: interrogate_broker THEN
  dup 4 = IF drop GOTO: weigh_station THEN
  drop GOTO: verdict_room
;SCENE

\ ---------------------------------------------------------------------------
\ Перевірка документів
\ ---------------------------------------------------------------------------
SCENE: check_documents
  CLS
  "Перевірка документації" LOCATION:
  "docs_checked" @ NOT IF
    "У накладній зазначено: 'Запчастини до сівалок і комбайнів (сталь 45)'. Вага нетто: 4200 кг." .
    "Країна відправлення — ОАЕ, кінцевий одержувач — фірма-одноденка без реєстрації платника ПДВ." .
    "Ви звіряєте код УКТЗЕД: під цим номером часто декларують високоточні авіаційні компоненти!" .
    1 "docs_checked" !
    1 "копія підозрілої накладної" ITEM+
  ELSE
    "Накладна містить невідповідність класифікації та ознаки підставного одержувача." .
  THEN

  "Повернутися до столу" CHOICE
  WAIT_CHOICE
  drop
  GOTO: office
;SCENE

\ ---------------------------------------------------------------------------
\ Огляд контейнера на рампі
\ ---------------------------------------------------------------------------
SCENE: inspect_container
  CLS
  "Оглядова рампа" LOCATION:
  "Великий 40-футовий контейнер опломбований болтовою номерною пломбою." .

  "seal_checked" @ NOT IF
    "Оглянути болтову пломбу з лупою" CHOICE
  THEN

  "портативний рентген-сканер" ITEM? IF
    "scan_done" @ NOT IF
      "Просвітити задню стінку контейнера рентгеном" CHOICE
    THEN
  ELSE
    "Взяти з боксу оптичний ендоскоп і сканер" CHOICE
  THEN

  "Повернутися в офіс" CHOICE
  WAIT_CHOICE

  "seal_checked" @ NOT IF
    dup 1 = IF
      drop
      1 "seal_checked" !
      1 "доказ: спиляна пломба" ITEM+
      "Під збільшенням видно: стрижень пломби акуратно перепиляно ювелірною пилкою і посаджено на суперклей. Контейнер відчиняли після завантаження!" .
      GOTO: inspect_container
    THEN
  THEN

  "портативний рентген-сканер" ITEM? NOT IF
    dup 1 = IF drop 1 "портативний рентген-сканер" ITEM+ GOTO: inspect_container THEN
    dup 2 = IF drop 1 "портативний рентген-сканер" ITEM+ GOTO: inspect_container THEN
  THEN

  "портативний рентген-сканер" ITEM? "scan_done" @ NOT AND IF
    dup 1 = IF
      drop
      1 "scan_done" !
      1 "знімок: приховані титанові блоки" ITEM+
      "Екран сканера чітко показує: за мішками з гайками сховані складні вузли з маркуванням серійних номерів ЧПК та титанового сплаву ВТ-6!" .
      GOTO: inspect_container
    THEN
  THEN

  drop
  GOTO: office
;SCENE

\ ---------------------------------------------------------------------------
\ Ваговий комплекс
\ ---------------------------------------------------------------------------
SCENE: weigh_station
  CLS
  "Автомобільні ваги" LOCATION:
  "Тягач заїжджає на платформу тензодатчиків." .
  "Електронне табло показує: брутто 21450 кг." .
  "Віднімаючи масу тягача та порожнього контейнера, чиста вага вантажу становить 5150 кг." .
  "У документах зазначено 4200 кг. Розбіжність майже у 950 кілограмів щільного металу!" .
  1 "акт невідповідності ваги" ITEM+

  "Повернутися в офіс" CHOICE
  WAIT_CHOICE
  drop
  GOTO: office
;SCENE

\ ---------------------------------------------------------------------------
\ Розмова з брокером
\ ---------------------------------------------------------------------------
SCENE: interrogate_broker
  CLS
  "Коридор біля термінала" LOCATION:
  "Брокер підходить ближче, оглядаючись на камери." .
  
  "bribe_offered" @ NOT IF
    "Брокер: 'Слухай, капітане, там просто зразки для заводу. Не гальмуй рейс. Ось тут конверт — 5 тисяч доларів, і ми потиснемо руки прямо зараз.'" .
    "Взяти конверт і мовчки підписати випуск" CHOICE
    "Відмовитися і попередити про кримінальну відповідальність" CHOICE
    WAIT_CHOICE
    1 = IF
      "Камери внутрішньої безпеки ДБР фіксують передачу хабаря в прямому ефірі. Вас затримано на гарячому під час посадового злочину." DEFEAT
    ELSE
      1 "bribe_offered" !
      "Брокер блідне: 'Ти пошкодуєш про це, інспекторе...' Він намагається вийти до авто." .
      1 "запис розмови на диктофон" ITEM+
      "Затримати брокера охороною КПП" CHOICE
      "Відпустити його на паркінг" CHOICE
      WAIT_CHOICE
      1 = IF
        1 "broker_arrested" !
        "Охорона блокує шлагбаум. Брокера затримано до з'ясування обставин." .
      ELSE
        "Брокер вислизнув через службовий вихід." .
      THEN
      GOTO: office
    THEN
  ELSE
    "Брокер сидить під наглядом охорони КПП і відмовляється давати покази без адвоката." .
    "Повернутися" CHOICE
    WAIT_CHOICE
    drop
    GOTO: office
  THEN
;SCENE

\ ---------------------------------------------------------------------------
\ Фінальне рішення
\ ---------------------------------------------------------------------------
SCENE: verdict_room
  CLS
  "Кабінет начальника митного поста" LOCATION:
  "Ви маєте ухвалити процесуальне рішення щодо вантажу MSCU-7721." .

  "Пропустити вантаж через брак прямих доказів" CHOICE
  "Скласти протокол про порушення митних правил (штраф за перевищення ваги)" CHOICE
  "Оформити протокол про контрабанду стратегічних матеріалів та викликати СБУ" CHOICE
  WAIT_CHOICE

  dup 1 = IF
    drop
    "Вантаж залишає термінал. Наступного дня з'ясовується, що сервоприводи призначалися для військового виробництва підсанкційної держави. Службове розслідування закінчується трибуналом." DEFEAT
  THEN

  dup 2 = IF
    drop
    "Ви виписуєте звичайний штраф за перевантаження. Власники сплачують копійки й забирають стратегічний вантаж зі сховища. Контрабандну схему не зупинено." DEFEAT
  THEN

  dup 3 = IF
    drop
    "docs_checked" @ IF
      "seal_checked" @ IF
        "scan_done" @ IF
          "акт невідповідності ваги" ITEM? IF
            "доказ: спиляна пломба" ITEM? IF
              "Ви передаєте слідчим оперативної групи СБУ повний пакет доказів: рентген-знімки титанових приводів, фіктивну накладну, пошкоджену пломбу та розбіжність у вазі. Міжнародний канал контрабанди повністю ліквідовано!" VICTORY
            THEN
          THEN
        THEN
      THEN
    THEN
    "Вам забракло підтверджених речових доказів або знімків сканування для обґрунтування контрабанди стратегічних матеріалів. Прокуратура відхиляє клопотання про арешт вантажу." DEFEAT
  THEN
  drop
;SCENE