\ ===========================================================================
\ КВЕСТ: "Аварія на метеостанції 'Північний шпіц'"
\ Виробничий трилер / виживання в екстремальних умовах
\ ===========================================================================

"Аварія на метеостанції" TITLE:
"Станція Північний шпіц" AUTHOR:
"1.0" VERSION:

\ ---------------------------------------------------------------------------
\ Прапорці предметів (гарантують, що речі беруться РІВНО ОДИН РАЗ)
\ ---------------------------------------------------------------------------
0 "item_wrench_taken" !
0 "item_heater_taken" !
0 "item_cable_taken" !
0 "item_fuel_taken" !

\ ---------------------------------------------------------------------------
\ Технологічні стани систем
\ ---------------------------------------------------------------------------
0 "fuel_warmed" !          \ чи відігріто паливну магістраль
0 "glow_plugs_hot" !       \ чи прогріто свічки розжарення
0 "decompressor_open" !    \ чи активовано декомпресор дизеля
0 "generator_running" !    \ чи дає дизель струм 380 В
0 "roof_cable_fixed" !     \ чи відновлено антенний фідер на даху
0 "radio_tuned" !          \ чи знайдено робочу хвилю криголама

22 "station_temp" !        \ Температура в приміщенні (°C)

: cool_down
  "station_temp" @ 2 - "station_temp" !
  "station_temp" @ -15 <= IF
    "Температура всередині станції впала нижче -15°C. Системи перемерзли, електроніка відмовила, ви замерзли на смерть у спальному мішку." .
    "Загибель від переохолодження під час полярного бурану." DEFEAT
  THEN
;

GOTO: житловий_блок


\ ---------------------------------------------------------------------------
\ ЛОКАЦІЯ 1: Житловий блок (Хаб метеостанції)
\ ---------------------------------------------------------------------------
SCENE: житловий_блок
  CLS
  "Житловий модуль станції" LOCATION:
  "Вітер люто б'є в потрійні шибки. Світло згасло, працює тьмяна аварійна лампа." .
  "Електронний термометр модуля показує: " . "station_temp" @ .
  "Якщо генератор не оживе найближчим часом, батареї аварійного світла сядуть, а станція перетвориться на крижану пастку." .

  "Пройти в машинне відділення до дизель-генератора" CHOICE
  "Оглянути склад і ремонтну майстерню" CHOICE
  "Піднятися на місток до радіорубки" CHOICE
  "Вийти через тамбур на дах до щогли (лютий буран)" CHOICE
  WAIT_CHOICE

  dup 1 = IF drop cool_down GOTO: машинне_відділення THEN
  dup 2 = IF drop cool_down GOTO: склад_майстерня THEN
  dup 3 = IF drop cool_down GOTO: радіорубка THEN
  drop cool_down GOTO: вихід_на_дах
;SCENE


\ ---------------------------------------------------------------------------
\ ЛОКАЦІЯ 2: Склад і ремонтна майстерня
\ ---------------------------------------------------------------------------
SCENE: склад_майстерня
  CLS
  "Майстерня та склад ЗІП" LOCATION:
  "Тут стоять шафи з інструментом, верстак та стелажі з аварійним обладнанням." .

  \ Перевірка через персональні змінні: кожен предмет можна взяти лише раз
  "item_wrench_taken" @ NOT IF
    "На магнітній планці висить комплект гайкових ключів 17-19." .
    "Взяти комбіновані ключі" CHOICE
  THEN

  "item_heater_taken" @ NOT IF
    "Під верстаком стоїть портативний газовий інфрачервоний пальник." .
    "Взяти газовий пальник" CHOICE
  THEN

  "item_fuel_taken" @ NOT IF
    "На нижній полиці стоїть каністра з антигелевою присадкою до арктичного ДП." .
    "Взяти каністру з антигелем" CHOICE
  THEN

  "item_cable_taken" @ NOT IF
    "У кутку лежить бухта товстого армованого коаксіального кабелю." .
    "Взяти бухту кабелю" CHOICE
  THEN

  "Повернутися до житлового модуля" CHOICE
  WAIT_CHOICE

  "item_wrench_taken" @ NOT IF
    dup 1 = IF
      drop
      1 "item_wrench_taken" !
      1 "гайкові ключі" ITEM+
      "Ви поклали ключі до кишені робочого комбінезона." .
      GOTO: склад_майстерня
    THEN
  THEN

  "item_heater_taken" @ NOT IF
    dup 1 = IF
      drop
      1 "item_heater_taken" !
      1 "інфрачервоний газовий пальник" ITEM+
      "Ви взяли заправлений пальник для прогріву замерзлих вузлів." .
      GOTO: склад_майстерня
    THEN
    dup 2 = IF
      drop
      1 "item_heater_taken" !
      1 "інфрачервоний газовий пальник" ITEM+
      "Ви взяли заправлений пальник." .
      GOTO: склад_майстерня
    THEN
  THEN

  "item_fuel_taken" @ NOT IF
    dup 1 = IF drop 1 "item_fuel_taken" ! 1 "каністра з антигелем" ITEM+ GOTO: склад_майстерня THEN
    dup 2 = IF drop 1 "item_fuel_taken" ! 1 "каністра з антигелем" ITEM+ GOTO: склад_майстерня THEN
    dup 3 = IF drop 1 "item_fuel_taken" ! 1 "каністра з антигелем" ITEM+ GOTO: склад_майстерня THEN
  THEN

  "item_cable_taken" @ NOT IF
    dup 1 = IF drop 1 "item_cable_taken" ! 1 "бухта кабелю" ITEM+ GOTO: склад_майстерня THEN
    dup 2 = IF drop 1 "item_cable_taken" ! 1 "бухта кабелю" ITEM+ GOTO: склад_майстерня THEN
    dup 3 = IF drop 1 "item_cable_taken" ! 1 "бухта кабелю" ITEM+ GOTO: склад_майстерня THEN
    dup 4 = IF drop 1 "item_cable_taken" ! 1 "бухта кабелю" ITEM+ GOTO: склад_майстерня THEN
  THEN

  drop
  GOTO: житловий_блок
;SCENE


\ ---------------------------------------------------------------------------
\ ЛОКАЦІЯ 3: Машинне відділення (Дизель-генератор ДГА-50)
\ ---------------------------------------------------------------------------
SCENE: машинне_відділення
  CLS
  "Машинний відсік" LOCATION:
  "У центрі стоїть важкий дизель ДГА-50. Корпус холодний, як крига. У скляному фільтрі-відстійнику дизпаливо побіліло й застигло желеподібним парафіном." .

  "generator_running" @ IF
    "Дизель-генератор рівно рохкає, вихлопна труба гаряча. На щиті горить зелений індикатор 380V!" .
  ELSE
    "fuel_warmed" @ NOT IF
      "Паливний фільтр забито парафіном." .
      "інфрачервоний газовий пальник" ITEM? IF
        "Відігріти газовим пальником фільтр та ТНВД" CHOICE
      THEN
      "каністра з антигелем" ITEM? IF
        "Залити антигель у витратний паливний бак" CHOICE
      THEN
    ELSE
      "Паливо рідке, прокачане помпою. Двигун готовий до спроби запуску." .
      "decompressor_open" @ NOT IF
        "Відкрити важіль декомпресора циліндрів" CHOICE
      THEN
      "glow_plugs_hot" @ NOT IF
        "Увімкнути тумблер підігріву свічок розжарення на 30 секунд" CHOICE
      THEN
      "Крутити стартер ключем пуску" CHOICE
    THEN
  THEN

  "Повернутися в житловий модуль" CHOICE
  WAIT_CHOICE

  "generator_running" @ NOT IF
    "fuel_warmed" @ NOT IF
      "інфрачервоний газовий пальник" ITEM? IF
        dup 1 = IF
          drop
          1 "fuel_warmed" !
          "М'яке інфрачервоне тепло розтоплює парафін у трубках та відстійнику. Паливо знову прозоре!" .
          GOTO: машинне_відділення
        THEN
      THEN

      "каністра з антигелем" ITEM? IF
        dup 1 = IF
          drop
          "Антигель не може розчинити вже кристалізований парафін у холодному фільтрі без прямого підігріву пальником." .
          GOTO: машинне_відділення
        THEN
        dup 2 = IF
          drop
          "Антигель не розтопить забитий фільтр без прогріву." .
          GOTO: машинне_відділення
        THEN
      THEN
    ELSE
      "decompressor_open" @ NOT IF
        dup 1 = IF
          drop
          1 "decompressor_open" !
          "Ви повертаєте важіль: випускні клапани підняті, колінвал тепер зможе легко розкрутитися стартером." .
          GOTO: машинне_відділення
        THEN
      THEN

      "glow_plugs_hot" @ NOT IF
        dup 1 = IF
          drop
          1 "glow_plugs_hot" !
          "Амперметр показує навантаження: свічки у форсуночних колодязях розжарилися до вишневого кольору." .
          GOTO: машинне_відділення
        THEN
        dup 2 = IF
          drop
          1 "glow_plugs_hot" !
          "Свічки розжарення прогріли вихрові камери." .
          GOTO: машинне_відділення
        THEN
      THEN

      \ Спроба запуску
      dup 1 = IF drop GOTO: спроба_пуску_дизеля THEN
      dup 2 = IF drop GOTO: спроба_пуску_дизеля THEN
      dup 3 = IF drop GOTO: спроба_пуску_дизеля THEN
    THEN
  THEN

  drop
  GOTO: житловий_блок
;SCENE

SCENE: спроба_пуску_дизеля
  CLS
  "Пуск двигуна" LOCATION:
  "decompressor_open" @ IF
    "glow_plugs_hot" @ IF
      1 "generator_running" !
      30 "station_temp" !
      "Стартер бадьоро крутить полегшений колінвал, ви опускаєте декомпресор — циліндри схоплюють спалах!" .
      "Дизель викидає клуб сизого диму і виходить на стабільні 1500 об/хв. Вмикаються конвектори опалення!" .
      "Натисніть для переходу" CHOICE
      WAIT_CHOICE
      drop
      GOTO: машинне_відділення
    ELSE
      "Холодні камери згоряння не запалили паливо. Стартер марно крутить вал, акумулятор втрачає заряд!" .
      "Спробуйте спочатку прогріти свічки розжарення." .
      "Назад" CHOICE
      WAIT_CHOICE
      drop
      GOTO: машинне_відділення
    THEN
  ELSE
    "Густе замерзле мастило та висока компресія вмить клинять стартер! Пусковий струм зпалює реле стартера!" .
    "Без декомпресора стартер згорів. Дизель не запустити, станція приречена на холод." DEFEAT
  THEN
;SCENE


\ ---------------------------------------------------------------------------
\ ЛОКАЦІЯ 4: Дах метеостанції (Аварія кабельної траси)
\ ---------------------------------------------------------------------------
SCENE: вихід_на_дах
  CLS
  "Плаский дах модуля — Шторм" LOCATION:
  "Шквальний вітер збиває з ніг, сніговий заряд засліплює очі. Температура тут -48°C." .

  "roof_cable_fixed" @ IF
    "Новий кабель надійно закріплений на щоглі й заведений у герметичний прохідний люк." .
  ELSE
    "Щогла антени вціліла, але радіочастотний кабель перебило зірваним металевим листом обшивки." .
    "бухта кабелю" ITEM? IF
      "гайкові ключі" ITEM? IF
        "Замінити пошкоджену лінію новим кабелем і обжати клеми" CHOICE
      ELSE
        "У вас є кабель, але відкрутити заіржавілі болти клемної коробки голими руками на морозі неможливо." .
      THEN
    ELSE
      "Потрібен цілий шматок коаксіального кабелю достатньої довжини." .
    THEN
  THEN

  "Негайно повернутися в тамбур" CHOICE
  WAIT_CHOICE

  "roof_cable_fixed" @ NOT IF
    "бухта кабелю" ITEM? "гайкові ключі" ITEM? AND IF
      dup 1 = IF
        drop
        1 "roof_cable_fixed" !
        1 "бухта кабелю" ITEM-
        "Боронячись від вітру, ви затягуєте болти розвідними ключами та ізолюєте муфту термоусадкою. Фідер антени відновлено!" .
        GOTO: вихід_на_дах
      THEN
    THEN
  THEN

  drop
  GOTO: житловий_блок
;SCENE


\ ---------------------------------------------------------------------------
\ ЛОКАЦІЯ 5: Радіорубка (Вихід на зв'язок)
\ ---------------------------------------------------------------------------
SCENE: радіорубка
  CLS
  "Апаратна радіозв'язку" LOCATION:
  "На столі стоїть короткохвильовий трансивер 'Ангара-РА' та навігаційний термінал." .

  "generator_running" @ NOT IF
    "Трансивер знеструмлений. Батареї зв'язку повністю розряджені. Потрібне живлення від головного генератора." .
  ELSE
    "roof_cable_fixed" @ NOT IF
      "Живлення є, але індикатор КСВ показує 'НЕСКІНЧЕННІСТЬ': антена обірвана на даху, передавати не можна — вихідний каскад згорить!" .
    ELSE
      "Трансивер ожив, підсвітка шкали світиться. В ефірі чути гуркіт атмосферних розрядів бурі." .
      "radio_tuned" @ NOT IF
        "Налаштувати частоту на аварійний канал криголама 'Красін' (2182 кГц)" CHOICE
      ELSE
        "Трансивер налаштований. В ефірі чути виклик диспетчера криголама!" .
        "Передати сигнал SOS та координати станції 'Північний шпіц'" CHOICE
      THEN
    THEN
  THEN

  "Спуститися назад" CHOICE
  WAIT_CHOICE

  "generator_running" @ "roof_cable_fixed" @ AND IF
    "radio_tuned" @ NOT IF
      dup 1 = IF
        drop
        1 "radio_tuned" !
        "Ви крутите верньєр на частоту 2182 кГц. Крізь тріск пробивається голос чергового радіооператора!" .
        GOTO: радіорубка
      THEN
    ELSE
      dup 1 = IF
        drop
        GOTO: фінал_порятунок
      THEN
    THEN
  THEN

  drop
  GOTO: житловий_блок
;SCENE


\ ---------------------------------------------------------------------------
\ ФІНАЛ: Порятунок полярників
\ ---------------------------------------------------------------------------
SCENE: фінал_порятунок
  CLS
  "Ефір на частоті порятунку" LOCATION:
  "Ви стискаєте тангенту мікрофона: 'Північний шпіц на зв'язку! Генератор запущено, люди живі, координати передаю...'" .
  "Динамік гучно відповідає: 'Північний шпіц, вас чуємо чисто! Криголам ліг на курс до вашої бухти. Тримайте тепло, виходимо на повний хід!'" .
  "Опалення станції працює надійно, шторм вам більше не страшний. Бездоганна інженерна робота!" VICTORY
;SCENE