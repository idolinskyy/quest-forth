\ ===========================================================================
\ КВЕСТ: "ГРІНУОЛД — ЗАБУТА ПЛАНЕТА"
\ За мотивами науково-фантастичного роману Кларка Дарлтона
\ ===========================================================================

"Грінуолд — Забута планета" TITLE:
"Кларк Дарлтон / адаптація" AUTHOR:
"1.0" VERSION:

\ ---------------------------------------------------------------------------
\ Ініціалізація змінних
\ ---------------------------------------------------------------------------
0 "reactor_stabilized" !
0 "found_crystals" !
0 "station_powered" !
0 "antenna_aligned" !
0 "filter_installed" !
0 "suit_charge" !
12 "suit_charge" !        \ Запас автономності скафандра (дії поза модулем)

: check_suit
  "suit_charge" @ 1 - "suit_charge" !
  "suit_charge" @ 0 <= IF
    "Кисневі регенератори скафандра вичерпали ресурс. Спори смарагдової флори забивають фільтри дихання." .
    "Задуха в токсичній атмосфері забутої планети." DEFEAT
  THEN
;

GOTO: модуль_аварія


\ ---------------------------------------------------------------------------
\ ЛОКАЦІЯ 1: Рятувальний модуль "Терра-4"
\ ---------------------------------------------------------------------------
SCENE: модуль_аварія
  CLS
  "Рятувальний катер 'Терра-4'" LOCATION:
  "Модуль лежить на боці серед розламаних велетенських гілок смарагдового кольору." .
  "Реактор аварійно заглушено. Бортовий передавач глухне в іонізованій імпервіальній імлі планети." .
  "Заряд батарей скафандра: " . "suit_charge" @ .

  "Оглянути пульт управління та блок зв'язку" CHOICE
  "Оглянути реакторний відсік катера" CHOICE
  "Перевірити шафу аварійного спорядження" CHOICE
  "Вийти через шлюз у смарагдовий ліс Грінуолду" CHOICE
  WAIT_CHOICE

  dup 1 = IF drop GOTO: рубка_зв_язку THEN
  dup 2 = IF drop GOTO: реакторний_блок THEN
  dup 3 = IF drop GOTO: шлюзовий_арсенал THEN
  drop check_suit GOTO: смарагдові_джунглі
;SCENE


\ ---------------------------------------------------------------------------
\ ЛОКАЦІЯ 2: Рубка зв'язку катера
\ ---------------------------------------------------------------------------
SCENE: рубка_зв_язку
  CLS
  "Рубка зв'язку модуля" LOCATION:
  "Екрани сканерів забиті шумами атмосферного радіовипромінювання Грінуолду." .
  
  "станція першої експедиції запеленгована" ITEM? NOT IF
    "дешифратор сигналів" ITEM? IF
      "Запустити спектральний пеленг поверхні крізь атмосферний шум" CHOICE
    ELSE
      "Потужності власного передавача не вистачає для зв'язку із Землею. Потрібен зовнішній ретранслятор або дешифратор частот." .
    THEN
  ELSE
    "Пеленгатор чітко тримає сигнал: за три кілометри на північному плато є покинута геофізична вежа першопрохідців!" .
  THEN

  "Повернутися до центрального відсіку" CHOICE
  WAIT_CHOICE

  "станція першої експедиції запеленгована" ITEM? NOT "дешифратор сигналів" ITEM? AND IF
    dup 1 = IF
      drop
      1 "станція першої експедиції запеленгована" ITEM+
      "Аналізатор пробиває шуми: на скелястому гребені виявлено пасивний маяк старої земної бази!" .
      GOTO: рубка_зв_язку
    THEN
  THEN

  drop
  GOTO: модуль_аварія
;SCENE


\ ---------------------------------------------------------------------------
\ ЛОКАЦІЯ 3: Реакторний блок
\ ---------------------------------------------------------------------------
SCENE: реакторний_блок
  CLS
  "Машинний відсік" LOCATION:
  "Тут тхне озоном. Контур охолодження генератора потріскався під час жорсткої посадки." .

  "reactor_stabilized" @ NOT IF
    "термостійкий герметик" ITEM? IF
      "Загерметизувати тріщину охолоджувача реактора" CHOICE
    ELSE
      "Із контуру сочиться фреонова емульсія. Без герметика запускати живильну лінію не можна." .
    THEN
  ELSE
    "Контур охолодження відновлено. Портативний паливний елемент готовий до вилучення." .
    "портативний термоядерний елемент" ITEM? NOT IF
      "Демонтувати портативний паливний елемент для вежі зв'язку" CHOICE
    THEN
  THEN

  "Назад" CHOICE
  WAIT_CHOICE

  "reactor_stabilized" @ NOT "термостійкий герметик" ITEM? AND IF
    dup 1 = IF
      drop
      1 "reactor_stabilized" !
      1 "термостійкий герметик" ITEM-
      "Ви нанесли шар полімеру під тиском. Тиск у системі стабілізувався!" .
      GOTO: реакторний_блок
    THEN
  THEN

  "reactor_stabilized" @ IF
    "портативний термоядерний елемент" ITEM? NOT IF
      dup 1 = IF
        drop
        1 "портативний термоядерний елемент" ITEM+
        "Ви вилучили компактний зарядний блок живлення. Тепер є енергія для зовнішніх приладів." .
        GOTO: реакторний_блок
      THEN
    THEN
  THEN

  drop
  GOTO: модуль_аварія
;SCENE


\ ---------------------------------------------------------------------------
\ ЛОКАЦІЯ 4: Шафа аварійного спорядження
\ ---------------------------------------------------------------------------
SCENE: шлюзовий_арсенал
  CLS
  "Аварійний арсенал" LOCATION:
  "Захисні контейнери для екстремальних умов невивчених планет." .

  "плазмовий різак" ITEM? NOT IF
    "В ніші закріплений важкий плазмовий різак для прокладання шляху крізь хащі." .
    "Взяти плазмовий різак" CHOICE
  THEN

  "термостійкий герметик" ITEM? NOT "reactor_stabilized" @ NOT AND IF
    "На полиці стоїть балон аерозольного силікатного герметика." .
    "Взяти балон герметика" CHOICE
  THEN

  "дешифратор сигналів" ITEM? NOT IF
    "У зарядному гнізді лежить польовий криптографічний сканер-пеленгатор." .
    "Взяти дешифратор" CHOICE
  THEN

  "Повернутися" CHOICE
  WAIT_CHOICE

  "плазмовий різак" ITEM? NOT IF
    dup 1 = IF drop 1 "плазмовий різак" ITEM+ GOTO: шлюзовий_арсенал THEN
  THEN

  "термостійкий герметик" ITEM? NOT "reactor_stabilized" @ NOT AND IF
    dup 1 = IF drop 1 "термостійкий герметик" ITEM+ GOTO: шлюзовий_арсенал THEN
    dup 2 = IF drop 1 "термостійкий герметик" ITEM+ GOTO: шлюзовий_арсенал THEN
  THEN

  "дешифратор сигналів" ITEM? NOT IF
    dup 1 = IF drop 1 "дешифратор сигналів" ITEM+ GOTO: шлюзовий_арсенал THEN
    dup 2 = IF drop 1 "дешифратор сигналів" ITEM+ GOTO: шлюзовий_арсенал THEN
    dup 3 = IF drop 1 "дешифратор сигналів" ITEM+ GOTO: шлюзовий_арсенал THEN
  THEN

  drop
  GOTO: модуль_аварія
;SCENE


\ ---------------------------------------------------------------------------
\ ЛОКАЦІЯ 5: Смарагдові нетрі Грінуолду (Хаб експедиції)
\ ---------------------------------------------------------------------------
SCENE: смарагдові_джунглі
  CLS
  "Первісний смарагдовий ліс" LOCATION:
  "Навколо підносяться стовбури хлорофілових велетнів заввишки у двісті метрів." .
  "Повітря густе від зеленого пилку, небо приховане шаром суцільних фосфоресцентних хмар." .
  "Залишок автономності скафандра: " . "suit_charge" @ .

  "Повернутися всередину катера 'Терра-4'" CHOICE
  "Рушити до базальтового каньйону (пошук ізолюючих мінералів)" CHOICE
  "Пробиватися на північний гребінь до ретранслятора" CHOICE
  WAIT_CHOICE

  dup 1 = IF drop GOTO: модуль_аварія THEN
  dup 2 = IF drop check_suit GOTO: базальтовий_каньйон THEN
  drop check_suit GOTO: скельний_гребінь
;SCENE


\ ---------------------------------------------------------------------------
\ ЛОКАЦІЯ 6: Базальтовий каньйон (Пошук берилієвих кристалів)
\ ---------------------------------------------------------------------------
SCENE: базальтовий_каньйон
  CLS
  "Ущелина кристалічних жил" LOCATION:
  "Рослинність тут поступається розламаним чорним скелям, розмитим кислотними росами." .

  "found_crystals" @ NOT IF
    "У товщі базальту виблискують пластини берилієвої слюди — ідеального хвилеводу для надпотужних сигналів." .
    "плазмовий різак" ITEM? IF
      "Вирізати пластини берилієвого хвилеводу плазмовим різаком" CHOICE
    ELSE
      "Порода занадто міцна — голими руками кристали не виламати. Потрібен термічний різак." .
    THEN
  ELSE
    "Жилу вироблено. Необхідні пластини слюди у вашому вантажному контейнері." .
  THEN

  "Повернутися до стежки джунглів" CHOICE
  WAIT_CHOICE

  "found_crystals" @ NOT "плазмовий різак" ITEM? AND IF
    dup 1 = IF
      drop
      1 "found_crystals" !
      1 "берилієвий хвилевід" ITEM+
      "Струмінь плазми зрізає цільний кристал берилію високої чистоти!" .
      GOTO: базальтовий_каньйон
    THEN
  THEN

  drop
  GOTO: смарагдові_джунглі
;SCENE


\ ---------------------------------------------------------------------------
\ ЛОКАЦІЯ 7: Північний гребінь та Стара вежа
\ ---------------------------------------------------------------------------
SCENE: скельний_гребінь
  CLS
  "Скелястий мис — База першої експедиції" LOCATION:
  "Вітер свистить над верхівками лісу. Тут стоїть каркас купола та похилена ферма гіперрадіовежі 1980-х років проекту 'Грінуолд'." .

  "станція першої експедиції запеленгована" ITEM? NOT IF
    "Ви бачите купол бази, але без точних частот дешифратора панелі управління заблоковані кодом безпеки." .
  ELSE
    "station_powered" @ NOT IF
      "портативний термоядерний елемент" ITEM? IF
        "Підключити термоядерний паливний елемент до шини живлення вежі" CHOICE
      ELSE
        "Головний силовий щит станції мертвий. Потрібне потужне автономне джерело струму." .
      THEN
    ELSE
      "Генератор вежі монотонно завиває. Живлення подано на тарілку випромінювача!" .
      "antenna_aligned" @ NOT IF
        "берилієвий хвилевід" ITEM? IF
          "Встановити берилієвий хвилевід і навести параболу в зеніт" CHOICE
        ELSE
          "Вихідний контур передавача прогорів від старого розряду блискавки. Потрібен новий кристалічний хвилевід." .
        THEN
      ELSE
        "Вежа готова до передачі SOS-сигналу крізь іоносферу Грінуолду!" .
        "Послати закодований сигнал лиха на опорну базу Флоту" CHOICE
      THEN
    THEN
  THEN

  "Спуститися назад до джунглів" CHOICE
  WAIT_CHOICE

  "станція першої експедиції запеленгована" ITEM? IF
    "station_powered" @ NOT IF
      "портативний термоядерний елемент" ITEM? IF
        dup 1 = IF
          drop
          1 "station_powered" !
          1 "портативний термоядерний елемент" ITEM-
          "Індикатори консолі спалахують смарагдово-зеленим світлом! Системи станції ожили після десятиліть простою." .
          GOTO: скельний_гребінь
        THEN
      THEN
    ELSE
      "antenna_aligned" @ NOT IF
        "берилієвий хвилевід" ITEM? IF
          dup 1 = IF
            drop
            1 "antenna_aligned" !
            1 "берилієвий хвилевід" ITEM-
            "Кристал ідеально ліг у фокус випромінювача. Частотна характеристика вирівнялася!" .
            GOTO: скельний_гребінь
          THEN
        THEN
      ELSE
        dup 1 = IF
          drop
          GOTO: фінал_порятунок
        THEN
      THEN
    THEN
  THEN

  drop
  GOTO: смарагдові_джунглі
;SCENE


\ ---------------------------------------------------------------------------
\ ФІНАЛ: Прорив крізь забуття
\ ---------------------------------------------------------------------------
SCENE: фінал_порятунок
  CLS
  "Головний термінал зв'язку вежі" LOCATION:
  "Потужний імпульс з берилієвого фокуса розсікає щільні зелені хмари над Грінуолдом." .
  "Промінь пробиває іоносферу і йде у відкритий космос на ретрансляційні буї Сонячної Системи." .
  "Динамік шипить, крізь тріск пробивається синтезований голос чергового диспетчера дальнього патруля:" .
  " 'Терра-4, сигнал прийнято. Квадрат Грінуолду ідентифіковано. Рятувальний крейсер вийшов із гіперпростору. Тримайтеся!'" .
  "Ви врятували експедицію і відкрили шлях до повернення із забутого світу!" VICTORY
;SCENE