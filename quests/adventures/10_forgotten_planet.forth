\ ===========================================================================
\ КВЕСТ: "ЗАБУТА ПЛАНЕТА" (за мотивами повісті Мюррея Лайнстера)
\ ===========================================================================

"Забута планета" TITLE:
"Мюррей Лайнстер / адаптація" AUTHOR:
"1.0" VERSION:

\ ---------------------------------------------------------------------------
\ Ініціалізація змінних та стану
\ ---------------------------------------------------------------------------
0 "knows_fire" !           \ чи зрозумів силу вогню / іскри
0 "saw_red_fungus" !       \ чи дослідив смертельний червоний гриб
0 "spider_killed" !        \ чи здолано володаря павутини
0 "tribe_inspired" !       \ чи готове плем'я йти за лідером
0 "path_cleared" !         \ чи розчищено підйом на пагорби

GOTO: грибне_селище


\ ---------------------------------------------------------------------------
\ ЛОКАЦІЯ 1: Грибне селище (Базовий табір у багнюці)
\ ---------------------------------------------------------------------------
SCENE: грибне_селище
  CLS
  "Низина велетенських грибів" LOCATION:
  "Вічна задуха, теплий безперервний туман і сморід гниття." .
  "Ваше плем'я ховається під капелюшком велетенського дощовика діаметром у двадцять метрів." .
  "Люди тремтять від кожного шороху: у тумані чути скрегіт хеліцер гігантських цвіркунів та павуків." .

  "Оглянути околиці грибного лісу" CHOICE
  "Спуститися до багнистого струмка (пошук каміння)" CHOICE
  "Оглянути небезпечні червоні споровики" CHOICE
  "Піднятися на край скельного схилу (до сонячного світла)" CHOICE
  "Підбадьорити налякане плем'я" CHOICE
  WAIT_CHOICE

  dup 1 = IF drop GOTO: грибний_ліс THEN
  dup 2 = IF drop GOTO: багнистий_струмок THEN
  dup 3 = IF drop GOTO: зона_червоного_гриба THEN
  dup 4 = IF drop GOTO: скельний_схил THEN
  drop GOTO: розмова_з_племенем
;SCENE


\ ---------------------------------------------------------------------------
\ ЛОКАЦІЯ 2: Багнистий струмок (Знаряддя та вогонь)
\ ---------------------------------------------------------------------------
SCENE: багнистий_струмок
  CLS
  "Русло теплого струмка" LOCATION:
  "Сіра тепла вода повільно тече серед коріння цвілевих паростків." .
  "Тут вода вимила шар твердих мінералів з глини." .

  "гострий уламок кременю" ITEM? NOT IF
    "На мілині ви помічаєте чорний уламок кременю з гострим, як ніж, краєм." .
    "Підібрати крем'яний ніж" CHOICE
  THEN

  "пірит (вогняний камінь)" ITEM? NOT IF
    "Поруч блищить важкий жовтуватий шматок залізного колчедану — піриту." .
    "Взяти камінь піриту" CHOICE
  THEN

  "гострий уламок кременю" ITEM? "пірит (вогняний камінь)" ITEM? AND IF
    "knows_fire" @ NOT IF
      "Спробувати вдарити кременем по піриту" CHOICE
    THEN
  THEN

  "Повернутися до селища" CHOICE
  WAIT_CHOICE

  "гострий уламок кременю" ITEM? NOT IF
    dup 1 = IF
      drop
      1 "гострий уламок кременю" ITEM+
      "Ви отримали ріжучий інструмент, здатний перерізати міцні рослинні волокна." .
      GOTO: багнистий_струмок
    THEN
  THEN

  "пірит (вогняний камінь)" ITEM? NOT IF
    dup 1 = IF drop 1 "пірит (вогняний камінь)" ITEM+ GOTO: багнистий_струмок THEN
    dup 2 = IF drop 1 "пірит (вогняний камінь)" ITEM+ GOTO: багнистий_струмок THEN
  THEN

  "knows_fire" @ NOT IF
    "гострий уламок кременю" ITEM? "пірит (вогняний камінь)" ITEM? AND IF
      dup 1 = IF
        drop
        1 "knows_fire" !
        1 "сухий трут із трутовика" ITEM+
        "Від удару зривається яскравий сніп гарячих іскор! Вони падають на пористий пилок — спалахує крихітний вогник." .
        "Плем'я ніколи не знало вогню. Тепер у ваших руках сила світла й тепла!" .
        GOTO: багнистий_струмок
      THEN
    THEN
  THEN

  drop
  GOTO: грибне_селище
;SCENE


\ ---------------------------------------------------------------------------
\ ЛОКАЦІЯ 3: Грибний ліс (Матеріали для списа)
\ ---------------------------------------------------------------------------
SCENE: грибний_ліс
  CLS
  "Зарості велетенських деревоподібних грибів" LOCATION:
  "Стовбури гігантських печериць сягають товщини дуба. Над головою шурхотять крила жука-носорога розміром з бізона." .

  "міцний триметровий держак" ITEM? NOT IF
    "гострий уламок кременю" ITEM? IF
      "Зрізати волокнистий пагін бамбукоподібного гриба" CHOICE
    ELSE
      "Тут є прямі пагони, але голіруч їх не зламати — потрібен гострий камінь." .
    THEN
  ELSE
    "міцний мисливський спис" ITEM? NOT IF
      "хітинове вістря оси" ITEM? IF
        "Прив'язати хітинове вістря до держака жилами" CHOICE
      THEN
    ELSE
      "У вас у руках важкий, добре збалансований спис." .
    THEN
  THEN

  "хітинове вістря оси" ITEM? NOT IF
    "На землі лежать рештки гігантської оси, яку загриз богомол. Її жало довжиною з меч ціле!" .
    "гострий уламок кременю" ITEM? IF
      "Вирізати жало та хітиновий кинджал оси" CHOICE
    THEN
  THEN

  "Повернутися в селище" CHOICE
  WAIT_CHOICE

  "міцний триметровий держак" ITEM? NOT "гострий уламок кременю" ITEM? AND IF
    dup 1 = IF
      drop
      1 "міцний триметровий держак" ITEM+
      "Ви зрізали прямий пружний держак." .
      GOTO: грибний_ліс
    THEN
  THEN

  "хітинове вістря оси" ITEM? NOT "гострий уламок кременю" ITEM? AND IF
    dup 1 = IF drop 1 "хітинове вістря оси" ITEM+ GOTO: грибний_ліс THEN
    dup 2 = IF drop 1 "хітинове вістря оси" ITEM+ GOTO: грибний_ліс THEN
  THEN

  "міцний мисливський спис" ITEM? NOT IF
    "міцний триметровий держак" ITEM? "хітинове вістря оси" ITEM? AND IF
      dup 1 = IF
        drop
        1 "міцний триметровий держак" ITEM-
        1 "хітинове вістря оси" ITEM-
        1 "міцний мисливський спис" ITEM+
        "Ви міцно закріпили гостре хітинове вістря рослинними жилами. Це перша справжня зброя людини на цій планеті!" .
        GOTO: грибний_ліс
      THEN
    THEN
  THEN

  drop
  GOTO: грибне_селище
;SCENE


\ ---------------------------------------------------------------------------
\ ЛОКАЦІЯ 4: Зона смертельного червоного гриба (Виготовлення отрути)
\ ---------------------------------------------------------------------------
SCENE: зона_червоного_гриба
  CLS
  "Поляна червоної цвілі" LOCATION:
  "Повітря тут щипає очі. На поваленому стовбурі росте криваво-червоний гриб Amanita Gigantea." .
  "Навколо лежать трупи велетенських мух та равликів — навіть крапля його соку паралізує нервову систему за лічені секунди." .

  "глечик зі смертоносним соком" ITEM? NOT IF
    "гострий уламок кременю" ITEM? IF
      "Надрізати шапку гриба і набрати отруйний сік у порожнистий горіх" CHOICE
    ELSE
      "Торкатися отруйного гриба голими руками — вірна смерть." .
    THEN
  ELSE
    "міцний мисливський спис" ITEM? IF
      "отруєний спис титана" ITEM? NOT IF
        "Змастити вістря списа концентрованою отрутою" CHOICE
      ELSE
        "Вістря вашого списа вкрите блискучою чорно-червоною отруйною плівкою." .
      THEN
    THEN
  THEN

  "Повернутися назад" CHOICE
  WAIT_CHOICE

  "глечик зі смертоносним соком" ITEM? NOT "гострий уламок кременю" ITEM? AND IF
    dup 1 = IF
      drop
      1 "глечик зі смертоносним соком" ITEM+
      1 "saw_red_fungus" !
      "Обережно зрізавши ніжку, ви наповнили шкаралупу смертоносним молочком." .
      GOTO: зона_червоного_гриба
    THEN
  THEN

  "міцний мисливський спис" ITEM? "отруєний спис титана" ITEM? NOT AND IF
    dup 1 = IF
      drop
      1 "міцний мисливський спис" ITEM-
      1 "глечик зі смертоносним соком" ITEM-
      1 "отруєний спис титана" ITEM+
      "Тепер вістря списа несе миттєвий параліч навіть для велетенського монстра!" .
      GOTO: зона_червоного_гриба
    THEN
  THEN

  drop
  GOTO: грибне_селище
;SCENE


\ ---------------------------------------------------------------------------
\ ЛОКАЦІЯ 5: Скельний схил (Лігво павука та вихід до сонця)
\ ---------------------------------------------------------------------------
SCENE: скельний_схил
  CLS
  "Ущелина кам'яного підйому" LOCATION:
  "Вгорі, крізь розриви вічного туману, пробивається сліпуче сонячне світло й видно сухі скелі." .
  "Але вузьку розколину перегороджує павутина товщиною в корабельні канати." .
  "У центрі сидить володар низини — десятиметровий смугастий павук-богомол з очима кольору кривавого рубіна." .

  "spider_killed" @ NOT IF
    "Кинутися в атаку на павука голіруч" CHOICE
    "otruyeny" "отруєний спис титана" ITEM? IF
      "Вдарити чудовисько отруєним списом у зчленування панцира" CHOICE
    THEN
    "knows_fire" @ IF
      "Підпалити павутину смолоскипом із сухого трута" CHOICE
    THEN
  ELSE
    "Велетенська туша павука лежить нерухомо. Шлях на сонячне плато вільний!" .
    "Піднятися на сонячне плато нагору" CHOICE
  THEN

  "Відступити до селища" CHOICE
  WAIT_CHOICE

  "spider_killed" @ NOT IF
    dup 1 = IF
      drop
      "Ви стрибаєте вперед без зброї. Велетенська волохата лапа збиває вас з ніг, а хеліцери впорскують травний сік..." .
      "Ви загинули в павутині володаря низин." DEFEAT
    THEN

    "отруєний спис титана" ITEM? IF
      dup 2 = IF
        drop
        1 "spider_killed" !
        1 "трофей: зуб велетенського павука" ITEM+
        "Ви робите точний випад прямо в головогруди! Отрута червоного гриба діє миттєво — потвора здригається в судомах і падає додолу мертвою." .
        "Ви виламуєте півметровий зуб монстра як доказ перемоги." .
        GOTO: скельний_схил
      THEN
    THEN

    "knows_fire" @ IF
      dup 2 = IF
        drop
        "Вогонь спалахує на нитках павутини, але розлючений павук вистрибує з диму прямо на вас!" .
        "Без смертоносної зброї зупинити стрибок монстра не вдалося." DEFEAT
      THEN
      dup 3 = IF
        drop
        "Вогонь спалахує на нитках павутини, але розлючений павук вистрибує з диму прямо на вас!" .
        "Без смертоносної зброї зупинити стрибок монстра не вдалося." DEFEAT
      THEN
    THEN
  ELSE
    dup 1 = IF
      drop
      "tribe_inspired" @ IF
        GOTO: тріумф_фінал
      ELSE
        "Ви стоїте на вершині самі. Але якщо залишити людей унизу — плем'я загине від комах." .
        "Потрібно повернутися і повести їх за собою." .
        "Повернутися до людей" CHOICE
        WAIT_CHOICE
        drop
        GOTO: грибне_селище
      THEN
    THEN
  THEN

  drop
  GOTO: грибне_селище
;SCENE


\ ---------------------------------------------------------------------------
\ ЛОКАЦІЯ 6: Розмова з племенем
\ ---------------------------------------------------------------------------
SCENE: розмова_з_племенем
  CLS
  "Селище — Коло людей" LOCATION:
  "Старійшини та жінки притискають дітей. Вони ніколи не бачили іншого життя, крім вічного страху й темряви." .

  "трофей: зуб велетенського павука" ITEM? IF
    "tribe_inspired" @ NOT IF
      "Показати зуб павука і запалити вогонь на очах племені" CHOICE
    ELSE
      "Люди дивляться на вас як на рятівника і готові рушати за першим словом." .
    THEN
  ELSE
    "Люди шепочуть: 'Павук з'їсть кожного, хто наблизиться до скель. Ми маємо коритися темряві.'" .
  THEN

  "Повернутися до справ" CHOICE
  WAIT_CHOICE

  "трофей: зуб велетенського павука" ITEM? "tribe_inspired" @ NOT AND IF
    dup 1 = IF
      drop
      1 "tribe_inspired" !
      "Ви кидаєте зуб страховиська під ноги старшим і ударом кременю викрешуєте полум'я!" .
      "Люди падають ниць від захвату. Страх розвіюється: людина знову стала мисливцем, а не здобиччю!" .
      "Тепер вони без вагань підуть за вами до ущелини." .
      GOTO: розмова_з_племенем
    THEN
  THEN

  drop
  GOTO: грибне_селище
;SCENE


\ ---------------------------------------------------------------------------
\ ФІНАЛ: Вихід людства на сонячне плато
\ ---------------------------------------------------------------------------
SCENE: тріумф_фінал
  CLS
  "Плато Вічного Сонця" LOCATION:
  "Ви виводите своє плем'я крізь розчищену ущелину на високе сухе плато." .
  "Вперше за сотні поколінь забуті люди відчувають на шкірі не липкий піт туману, а тепло справжнього променистого сонця." .
  "Унизу залишається світ сліпих комах та грибів. Попереду — ліси земних дерев, річки з чистою водою та відродження людської цивілізації!" .
  "Ви перемогли первісний жах і повернули людям розум та гідність володарів планети!" VICTORY
;SCENE