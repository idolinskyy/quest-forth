\ ===========================================================================
\ КВЕСТ 1: "Аварія на горизонті 400"
\ Реалістичний інженерний квест на виживання та логіку
\ ===========================================================================

"Аварія на горизонті 400" TITLE:
"Олександр К." AUTHOR:
"1.0" VERSION:

\ ---------------------------------------------------------------------------
\ Ініціалізація змінних
\ ---------------------------------------------------------------------------
0 "power_on" !
0 "pump_working" !
0 "gas_checked" !
0 "fuse_replaced" !
0 "water_level" !        \ 0: норма, 1: критичний
0 "lift_ready" !
0 "turns_left" !
10 "turns_left" !        \ Ліміт дій до повного затоплення підстанції

: check_timer
  "turns_left" @ 1 - "turns_left" !
  "turns_left" @ 0 <= IF
    "Рівень води перекрив високовольтні кабелі до того, як ви встигли діяти. Горизонт повністю знеструмлено та затоплено." DEFEAT
  THEN
;

SCENE: start
  CLS
  "Штрек горизонту 400" LOCATION:
  "Блимає аварійна лампа. Десь удалині глухо завиває сирена зумпфа." .
  "Зміна з трьох гірників заблокована біля рудоспуску." .
  "Вам необхідно розібратися з підстанцією, запустити помпу і підготувати підйомник." .
  "До повного затоплення машинної камери лишилося обмаль часу." .
  "Почати огляд" CHOICE
  WAIT_CHOICE
  drop
  GOTO: hub
;SCENE

\ ---------------------------------------------------------------------------
\ Головний хаб (Розвилка горизонту)
\ ---------------------------------------------------------------------------
SCENE: hub
  CLS
  "Центральний вузол горизонту" LOCATION:
  "Вода під ногами вже сягає щиколоток." .
  "Залишок часу (умовних дій): " . "turns_left" @ .
  
  "Піти до розподільчої електропідстанції" CHOICE
  "Спуститися до насосної камери (зумпф)" CHOICE
  "Оглянути ствол шахти та кліть ліфта" CHOICE
  "Зайти до комірчини інструментів" CHOICE
  "Оцінити стан вентиляції та завалу" CHOICE
  WAIT_CHOICE

  dup 1 = IF drop check_timer GOTO: substation THEN
  dup 2 = IF drop check_timer GOTO: pump_room THEN
  dup 3 = IF drop check_timer GOTO: lift_shaft THEN
  dup 4 = IF drop check_timer GOTO: tool_room THEN
  drop check_timer GOTO: ventilation_check
;SCENE

\ ---------------------------------------------------------------------------
\ Комірчина інструментів
\ ---------------------------------------------------------------------------
SCENE: tool_room
  CLS
  "Інструментальна комірчина" LOCATION:
  "На металевих стелажах лежить змінне обладнання." .

  "шахтний інтерферометр ШІ-11" ITEM? NOT IF
    "На столі лежить опломбований газоаналізатор ШІ-11." .
    "Взяти газоаналізатор" CHOICE
  THEN

  "запобіжник ПН-2 250А" ITEM? NOT IF
    "У відкритій коробці лежить високовольтний керамічний запобіжник." .
    "Взяти запобіжник 250А" CHOICE
  THEN

  "діелектричні рукавиці" ITEM? NOT IF
    "На гачку висять випробувані діелектричні рукавиці." .
    "Взяти рукавиці" CHOICE
  THEN

  "гайковий ключ 32х36" ITEM? NOT IF
    "Під верстаком лежить важкий ріжковий ключ." .
    "Взяти ключ 32х36" CHOICE
  THEN

  "Повернутися в центральний вузол" CHOICE
  WAIT_CHOICE

  "шахтний інтерферометр ШІ-11" ITEM? NOT IF
    dup 1 = IF
      drop
      1 "шахтний інтерферометр ШІ-11" ITEM+
      "Ви повісили прилад контролю метану на плече." .
      GOTO: tool_room
    THEN
  THEN

  "запобіжник ПН-2 250А" ITEM? NOT IF
    dup 1 = IF
      drop
      1 "запобіжник ПН-2 250А" ITEM+
      "Ви поклали запобіжник до сумки." .
      GOTO: tool_room
    THEN
    dup 2 = IF
      drop
      1 "запобіжник ПН-2 250А" ITEM+
      "Ви поклали запобіжник до сумки." .
      GOTO: tool_room
    THEN
  THEN

  "діелектричні рукавиці" ITEM? NOT IF
    dup 1 = IF drop 1 "діелектричні рукавиці" ITEM+ GOTO: tool_room THEN
    dup 2 = IF drop 1 "діелектричні рукавиці" ITEM+ GOTO: tool_room THEN
    dup 3 = IF drop 1 "діелектричні рукавиці" ITEM+ GOTO: tool_room THEN
  THEN

  "гайковий ключ 32х36" ITEM? NOT IF
    dup 1 = IF drop 1 "гайковий ключ 32х36" ITEM+ GOTO: tool_room THEN
    dup 2 = IF drop 1 "гайковий ключ 32х36" ITEM+ GOTO: tool_room THEN
    dup 3 = IF drop 1 "гайковий ключ 32х36" ITEM+ GOTO: tool_room THEN
    dup 4 = IF drop 1 "гайковий ключ 32х36" ITEM+ GOTO: tool_room THEN
  THEN

  drop
  GOTO: hub
;SCENE

\ ---------------------------------------------------------------------------
\ Підстанція
\ ---------------------------------------------------------------------------
SCENE: substation
  CLS
  "Підземна підстанція" LOCATION:
  "Головна шафа 6 кВ вибита. Запах горілого гетинаксу." .

  "power_on" @ IF
    "Підстанція гуде під навантаженням. Лінії живлення активні." .
  ELSE
    "Головний автомат знеструмлений через згорілий фазний запобіжник." .
    "fuse_replaced" @ IF
      "Новий запобіжник установлено. Можна подати рубильник." .
      "Увімкнути головний рубильник 6 кВ" CHOICE
    ELSE
      "запобіжник ПН-2 250А" ITEM? IF
        "Замінити згорілий запобіжник новим" CHOICE
      THEN
    THEN
  THEN

  "Повернутися назад" CHOICE
  WAIT_CHOICE

  "power_on" @ NOT IF
    "fuse_replaced" @ IF
      dup 1 = IF
        drop
        "gas_checked" @ IF
          1 "power_on" !
          "Клацання контактора! Вмикається аварійне освітлення та вентиляція." .
          GOTO: substation
        ELSE
          "Вимикання високої напруги без перевірки атмосфери на метан викликало іскріння та вибух суміші газів!" .
          "Вибух метану через недбалість при вмиканні високої напруги." DEFEAT
        THEN
      THEN
    ELSE
      "запобіжник ПН-2 250А" ITEM? IF
        dup 1 = IF
          drop
          "діелектричні рукавиці" ITEM? IF
            1 "fuse_replaced" !
            1 "запобіжник ПН-2 250А" ITEM-
            "Одягнувши рукавиці, ви обережно вилучили плавку вставку і поставили новий ПН-2." .
          ELSE
            "Спроба замінити високовольтний запобіжник мокрими голими руками призвела до ураження залишковим струмом!" .
            "Смертельне ураження електричним струмом." DEFEAT
          THEN
          GOTO: substation
        THEN
      THEN
    THEN
  THEN

  drop
  GOTO: hub
;SCENE

\ ---------------------------------------------------------------------------
\ Насосна камера
\ ---------------------------------------------------------------------------
SCENE: pump_room
  CLS
  "Водовідливний зумпф" LOCATION:
  "Вода прибуває зі швидкістю пів кубометра за хвилину. Насос 1Д-315 заблокований повітряною пробкою і відключений від живлення." .

  "pump_working" @ IF
    "Помпа потужно гуде, рівень води в зумпфі швидко спадає." .
  ELSE
    "power_on" @ IF
      "Живлення на двигун подано." .
      "гайковий ключ 32х36" ITEM? IF
        "Стравити повітря клапаном через ключ та запустити насос" CHOICE
      ELSE
        "Спробувати запустити помпу всуху без стравлювання" CHOICE
      THEN
    ELSE
      "Насос повністю знеструмлений." .
    THEN
  THEN

  "Повернутися в центральний вузол" CHOICE
  WAIT_CHOICE

  "pump_working" @ NOT "power_on" @ AND IF
    dup 1 = IF
      drop
      "гайковий ключ 32х36" ITEM? IF
        1 "pump_working" !
        "Ви відкрутили повітряний штуцер ключем, вода заповнила равлик, і помпа пішла в робочий режим!" .
        GOTO: pump_room
      ELSE
        "Крильчатка помпи заклинила через кавітацію і перегрів на сухому ходу. Двигун згорів!" .
        "Помпу безповоротно виведено з ладу. Затоплення неминуче." DEFEAT
      THEN
    THEN
  THEN

  drop
  GOTO: hub
;SCENE

\ ---------------------------------------------------------------------------
\ Перевірка вентиляції
\ ---------------------------------------------------------------------------
SCENE: ventilation_check
  CLS
  "Вентиляційний збійний штрек" LOCATION:
  "Тут тяга повітря слабка. Потрібно переконатися у безпеці рудникової атмосфери." .

  "шахтний інтерферометр ШІ-11" ITEM? IF
    "gas_checked" @ NOT IF
      "Зробити замір концентрації метану та СО" CHOICE
    ELSE
      "Замір виконано: СН4 — 0.4% (норма), СО — сліди. Іскробезпечно." .
    THEN
  ELSE
    "Без газоаналізатора визначити наявність метану неможливо." .
  THEN

  "Назад" CHOICE
  WAIT_CHOICE

  "шахтний інтерферометр ШІ-11" ITEM? "gas_checked" @ NOT AND IF
    dup 1 = IF
      drop
      1 "gas_checked" !
      "Ви прокачуєте грушу інтерферометра. Газовий склад у межах дозволеного ПБ." .
      GOTO: ventilation_check
    THEN
  THEN

  drop
  GOTO: hub
;SCENE

\ ---------------------------------------------------------------------------
\ Ствол шахти та евакуація
\ ---------------------------------------------------------------------------
SCENE: lift_shaft
  CLS
  "Околоствольний двір" LOCATION:
  "Кліть вантажолюдського підйомника стоїть на посадкових кулаках." .

  "power_on" @ "pump_working" @ AND IF
    "Вода відступила, сигналізатор ствола блимає зеленим: підйомник готовий до руху." .
    "Подати сигнал зв'язку '1-1' на поверхню та підняти зміну" CHOICE
  ELSE
    "Підйомник не працює: немає сигналу підстанції або затоплено приямок зумпфа." .
  THEN

  "Назад" CHOICE
  WAIT_CHOICE

  "power_on" @ "pump_working" @ AND IF
    1 = IF
      "Сигнал прийнято диспетчером. Кліть рушає догори. Уся зміна врятована, аварію ліквідовано без людських втрат!" VICTORY
    THEN
  THEN

  drop
  GOTO: hub
;SCENE